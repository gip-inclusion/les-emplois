                  <ul class="c-box--results__list-contact flex-md-grow-1 mt-2 mb-2 mb-md-0">
                      <li>
                          <i aria-hidden="true" class="ri-map-pin-2-line fw-normal me-1">
                          </i>
                          À distance
                      </li>
                  </ul>
                  <div class="mt-md-1">
                      <a aria-label="Voir la fiche détaillée de Une structure" class="btn btn-outline-primary btn-block w-100 w-md-auto white-space-nowrap stretched-link" href="/insertion/services/autre-distanciel/?back_url=%2Fsearch%2Fservices%2Fresults%3Fcity%3Dvannes-56%26category%3Dmobilite%26reception%3Dtous">
                          <span>
