          <hr class="m-0"/>
          <div class="c-box--results__body">
              <span class="badge badge-xs rounded-pill bg-info">
                  Mobilisation par : Formulaire | Email
              </span>
              <span class="badge badge-xs rounded-pill bg-light text-primary">
                  Source : dora, via data·inclusion
              </span>
          </div>
      </div>
      <div class="c-box c-box--results has-one-link-inside mb-3 mb-md-4">
