          'wrapper[utils/readonly.py]',
        ]),
        'sql': '''
          SELECT COUNT(*) AS "__count"
          FROM "insertion_service"
          INNER JOIN "insertion_service_receptions" ON ("insertion_service"."id" = "insertion_service_receptions"."service_id")
          WHERE ("insertion_service"."is_active"
                 AND "insertion_service"."coordinates" IS NOT NULL
                 AND EXISTS
                   (SELECT %s AS "a"
                    FROM "insertion_service_thematics" U0
                    WHERE (U0."genericreferenceitem_id" IN (%s)
                           AND U0."service_id" = ("insertion_service"."id"))
                    LIMIT 1)
                 AND NOT ("insertion_service"."city" = %s)
                 AND ST_DWithin("insertion_service"."coordinates", %s, %s)
                 AND "insertion_service_receptions"."genericreferenceitem_id" IN (%s)
                 AND ("insertion_service"."eligibility_zones" && (ARRAY[%s,
                                                                        %s,
                                                                        %s])::varchar[]
                      OR "insertion_service"."eligibility_zones" = %s::varchar[])
                 AND ("insertion_service"."extra" -> %s) ? | %s)
        ''',
