                      </li>
                      <li>
                          <span class="badge badge-sm rounded-pill bg-info text-white">
                              Également disponible à distance
                          </span>
                      </li>
                  </ul>
                  <div class="mt-md-1">
                      <a aria-label="Voir la fiche détaillée de Une structure" class="btn btn-outline-primary btn-block w-100 w-md-auto white-space-nowrap stretched-link" href="/insertion/services/dora-presentiel/?back_url=%2Fsearch%2Fservices%2Fresults%3Fcity%3Dvannes-56%26category%3Dmobilite%26reception%3Dtous">
