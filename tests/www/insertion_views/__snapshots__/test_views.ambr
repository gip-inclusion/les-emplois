                 "insertion_structure"."opening_hours",
                 "insertion_structure"."updated_on",
                 "insertion_structure"."is_active",
                 "insertion_structure"."created_at",
                 "insertion_structure"."updated_at"
          FROM "insertion_orientation"
          INNER JOIN "users_user" ON ("insertion_orientation"."beneficiary_id" = "users_user"."id")
          INNER JOIN "users_user" T4 ON ("insertion_orientation"."sender_id" = T4."id")
          INNER JOIN "insertion_service" ON ("insertion_orientation"."service_id" = "insertion_service"."id")
          INNER JOIN "insertion_structure" ON ("insertion_service"."structure_id" = "insertion_structure"."id")
          WHERE "insertion_orientation"."sender_prescriber_organization_id" = %s
          ORDER BY "insertion_orientation"."updated_at" DESC
          LIMIT 2
        ''',
      }),
      dict({
        'origin': list([
          'Atomic.__exit__[<site-packages>/django/db/transaction.py]',
        ]),
        'sql': 'RELEASE SAVEPOINT "<snapshot>"',
      }),
    ]),
  })
