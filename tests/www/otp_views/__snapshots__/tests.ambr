# serializer version: 1
# name: TestEnrollmentStep4BackupCode.test_view
  '''
  <main class="s-main" id="main" role="main">
      <div aria-atomic="true" aria-live="polite" class="toast-container">
      </div>
      <section class="s-title-02">
          <div class="s-title-02__container container">
              <div class="s-title-02__row row">
                  <div class="s-title-02__col col-12">
                      <div class="c-title">
                          <div class="c-title__main">
                              <h1>
                                  Sécurisez votre accès
                              </h1>
                          </div>
                      </div>
                      <div class="alert alert-warning" role="status">
                          <div class="row">
                              <div class="col-auto pe-0">
                                  <i aria-hidden="true" class="ri-error-warning-line ri-xl text-warning">
                                  </i>
                              </div>
                              <div class="col">
                                  <p class="mb-2">
                                      <strong>
                                          Ne passez pas cette page sans avoir noté votre code de récupération.
                                      </strong>
                                  </p>
                                  <p>
                                      Il est
                                      <strong>
                                          généré une seule fois
                                      </strong>
                                      et ne sera plus accessible ensuite.
                                  </p>
                                  <ul class="mb-0">
                                      <li>
                                          Sans lui,
                                          <strong>
                                              vous ne pourrez plus accéder à votre compte
                                          </strong>
                                          si vous perdez ou changez votre appareil.
                                      </li>
                                      <li>
                                          <strong>
                                              Conservez-le dans un endroit sécurisé :
                                          </strong>
                                          gestionnaire de mots de passe, document imprimé, coffre-fort numérique…
                                      </li>
                                      <li>
                                          Si vous utilisez l’application mobile pour l’authentification forte,
                                          <strong>
                                              évitez de stocker ce code sur ce même téléphone
                                          </strong>
                                          , vous risqueriez de tout perdre en même temps.
                                      </li>
                                  </ul>
                              </div>
                          </div>
                      </div>
                  </div>
              </div>
          </div>
      </section>
      <section class="s-section">
          <div class="s-section__container container">
              <div class="s-section__row row">
                  <div class="s-section__col col-12">
                      <div class="c-stepper mb-3 mb-md-4">
                          <div class="progress">
                              <div aria-labelledby="currentProgressState" aria-valuemax="100" aria-valuemin="0" aria-valuenow="100" class="progress-bar progress-bar-100" role="progressbar">
                              </div>
                          </div>
                          <p id="currentProgressState">
                              <strong>
                                  Étape 4
                              </strong>
                              /4 : sauvegardez le code de récupération
                          </p>
                      </div>
                  </div>
              </div>
              <div class="s-section__row row">
                  <div class="section__col col-12">
                      <div class="c-form mb-3 mb-md-4">
                          <h2 class="h3">
                              Votre code de récupération à conserver
                          </h2>
                          <p class="mb-1">
                              <strong>
                                  Code de récupération
                              </strong>
                          </p>
                          <p>
                              <span>
                                  BACKUP-CODE
                              </span>
                              <button class="btn-ico btn-link btn-sm ms-2 py-0" data-bs-placement="right" data-bs-title="Copié !" data-bs-toggle="tooltip" data-bs-trigger="manual" data-it-clipboard-button="copy" data-it-copy-to-clipboard="BACKUP-CODE" type="button">
                                  <i aria-hidden="true" class="ri-file-copy-line fw-normal">
                                  </i>
                                  <span>
                                      Copier
                                  </span>
                              </button>
                          </p>
                          <form method="post">
                              <input name="csrfmiddlewaretoken" type="hidden" value="NORMALIZED_CSRF_TOKEN"/>
                              <div class="form-group">
                                  <div class="form-check">
                                      <input class="form-check-input" id="confirmation-checkbox" required="" type="checkbox"/>
                                      <label class="form-check-label" for="confirmation-checkbox">
                                          Je confirme avoir noté mon code de récupération et j’ai compris que je n’aurai plus l’occasion de le retrouver sur la plateforme.
                                          <br class="d-none d-xl-inline"/>
                                          Il me sera nécessaire si je perds accès à mon application ou à mon appareil. *
                                      </label>
                                  </div>
                              </div>
                              <div class="row">
                                  <div class="col-12">
                                      <hr class="mb-3"/>
                                      <small class="d-inline-block mb-3">
                                          * champs obligatoires
                                      </small>
                                      <div class="form-row align-items-center justify-content-end gx-3">
                                          <div class="form-group col col-lg-auto order-2 order-lg-3">
                                              <button class="btn btn-block btn-primary" id="end-button" type="submit">
                                                  <span>
                                                      Terminer
                                                  </span>
                                              </button>
                                          </div>
                                      </div>
                                  </div>
                              </div>
                          </form>
                      </div>
                  </div>
              </div>
          </div>
      </section>
  </main>
  
  '''
# ---
# name: TestLogin.test_login_shows_list_of_devices
  '''
  <div class="c-form mb-5">
      <h2>
          Double authentification
      </h2>
      <div class="alert alert-info" role="status">
          <div class="row">
              <div class="col-auto pe-0">
                  <i aria-hidden="true" class="ri-information-line ri-xl text-info">
                  </i>
              </div>
              <div class="col">
                  <p class="mb-2">
                      <strong>
                          Ouvrez l’un de vos appareils configurés et recopiez le code affiché
                      </strong>
                  </p>
                  <ol class="list-unstyled">
                      <li>
                          <em>
                              Mon appareil
                          </em>
                          –
                                                  Dernière utilisation le
                                                  01 juin 2026 à 12h00
                      </li>
                  </ol>
                  <p>
                      <strong>
                          Vous n’avez plus accès à votre appareil ?
                      </strong>
                      <a class="btn-link" href="/otp/login-with-backup-code">
                          Cliquez ici pour utiliser votre code de récupération
                      </a>
                      .
                  </p>
                  <h5>
                      Où trouver mon code ?
                  </h5>
                  <p>
                      Lors de l’activation de la double authentification, vous avez associé votre compte à une
                      <strong>
                          application d’authentification
                      </strong>
                      installée sur votre téléphone ou votre ordinateur.
                  </p>
                  <p>
                      Il s’agit peut-être de l’une des
                      <a aria-label="Ouverture dans un nouvel onglet" href="/otp/apps" target="_blank">
                          applications recommandées
                      </a>
                      , comme Google Authenticator, Aegis, Microsoft Authenticator, Authy, ou un gestionnaire de mots de passe comme Bitwarden.
                  </p>
                  <p class="mb-0">
                      Elle affiche automatiquement un
                      <strong>
                          code à 6 chiffres
                      </strong>
                      à recopier ci-dessous.
                  </p>
              </div>
          </div>
      </div>
      <form class="js-prevent-multiple-submit" method="post">
          <input name="csrfmiddlewaretoken" type="hidden" value="NORMALIZED_CSRF_TOKEN"/>
          <fieldset>
              <div class="form-group form-group-required">
                  <label class="form-label" for="id_otp_token">
                      Entrez le code de validation unique (OTP)
                  </label>
                  <input aria-describedby="id_otp_token_helptext" autocomplete="one-time-code" autofocus="" class="form-control" id="id_otp_token" maxlength="6" name="otp_token" required="" type="text"/>
                  <div class="form-text" id="id_otp_token_helptext">
                      Code à 6 chiffres généré par votre application mobile ou votre gestionnaire de mot de passe sur votre ordinateur
                  </div>
              </div>
          </fieldset>
          <div class="row">
              <div class="col-12">
                  <hr class="mb-3"/>
                  <small class="d-inline-block mb-3">
                      * champs obligatoires
                  </small>
                  <div class="form-row align-items-center justify-content-end gx-3">
                      <div class="form-group col-12 col-lg order-3 order-lg-1">
                      </div>
                      <div class="form-group col col-lg-auto order-2 order-lg-3">
                          <button aria-label="Passer à l’étape suivante" class="btn btn-block btn-primary" type="submit">
                              <span>
                                  Valider
                              </span>
                          </button>
                      </div>
                  </div>
              </div>
          </div>
      </form>
  </div>
  
  '''
# ---
# name: test_delete_devices[with_device]
  '''
  <section class="s-section">
      <div class="s-section__container container">
          <div class="s-section__row row">
              <div class="s-section__col col-12">
                  <div class="d-flex flex-column flex-lg-row gap-3 align-items-lg-center justify-content-lg-between mb-3">
                      <h2 class="mb-0">
                          Mes appareils
                      </h2>
                      <div aria-label="Actions sur les collaborateurs" class="d-flex flex-column flex-md-row gap-2 justify-content-md-end" role="group">
                          <a class="btn btn-primary btn-ico" href="/otp/enrollment-step-1">
                              Configurer un
                                  nouvel
                                  appareil
                          </a>
                      </div>
                  </div>
                  <p>
                      Voici la liste de vos appareils configurés :
                  </p>
                  <div class="table-responsive mt-3 mt-md-4">
                      <table class="table table-sm">
                          <caption class="visually-hidden">
                              Liste de vos appareils configurés
                          </caption>
                          <thead>
                              <tr>
                                  <th class="w-50px" scope="col">
                                  </th>
                                  <th scope="col">
                                      Nom
                                  </th>
                                  <th scope="col">
                                      Créé le
                                  </th>
                                  <th scope="col">
                                      Dernière utilisation
                                  </th>
                                  <th class="text-end w-50px" scope="col">
                                      <span class="visually-hidden">
                                          Actions possibles sur les appareils configurés
                                      </span>
                                  </th>
                              </tr>
                          </thead>
                          <tbody>
                              <tr>
                                  <td>
                                      <i aria-label="Vous avez utilisé cet appareil pour vous connecter." class="ri-verified-badge-fill text-success" data-bs-placement="top" data-bs-title="Vous avez utilisé cet appareil pour vous connecter." data-bs-toggle="tooltip">
                                      </i>
                                  </td>
                                  <td>
                                      authenticator
                                  </td>
                                  <td>
                                      11 mars 2025 06:18
                                  </td>
                                  <td>
                                      11 mars 2025 06:20
                                  </td>
                                  <td class="text-end w-50px">
                                      <span aria-label="Impossible de supprimer l’appareil que vous avez utilisé pour vous connecter." class="btn btn-sm btn-secondary btn-ico-only disabled" data-bs-placement="top" data-bs-title="Impossible de supprimer l’appareil que vous avez utilisé pour vous connecter." data-bs-toggle="tooltip" tabindex="0">
                                          <i aria-hidden="true" class="ri-arrow-drop-right-line fs-lg">
                                          </i>
                                      </span>
                                  </td>
                              </tr>
                              <tr>
                                  <td>
                                  </td>
                                  <td>
                                      bitwarden
                                  </td>
                                  <td>
                                      11 mars 2025 06:19
                                  </td>
                                  <td>
                                      <i class="text-disabled">
                                          jamais
                                      </i>
                                  </td>
                                  <td class="text-end w-50px">
                                      <button aria-label="Supprimer l’appareil bitwarden" class="btn btn-sm btn-secondary btn-ico-only" data-bs-target="#delete_[PK of device_2]_modal" data-bs-toggle="modal" type="button">
                                          <i aria-hidden="true" class="ri-delete-bin-line fw-normal">
                                          </i>
                                      </button>
                                  </td>
                              </tr>
                          </tbody>
                      </table>
                  </div>
              </div>
          </div>
      </div>
  </section>
  
  '''
