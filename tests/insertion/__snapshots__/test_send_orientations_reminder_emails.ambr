          LEFT OUTER JOIN "companies_company" ON ("insertion_orientation"."sender_company_id" = "companies_company"."id")
          INNER JOIN "insertion_service" ON ("insertion_orientation"."service_id" = "insertion_service"."id")
          WHERE ("insertion_orientation"."status" = %s
                 AND (("insertion_orientation"."created_at" <= %s
                       AND "insertion_orientation"."last_reminder_email_sent_at" IS NULL)
                      OR "insertion_orientation"."last_reminder_email_sent_at" <= %s)
                 AND "insertion_orientation"."created_at" >= %s)
          ORDER BY "insertion_orientation"."created_at" ASC,
                   "insertion_orientation"."id" ASC
          LIMIT 100
        ''',
